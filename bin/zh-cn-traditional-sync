#!/usr/bin/env python3
"""
zh-cn-traditional-sync - 動態將系統 zh_CN 翻譯轉換爲 zh_CN@traditional（繁體字形 + 大陸術語）。
支持：
  1. 手動全量同步 (--all) 或指定組件 (如 zh-cn-traditional-sync git gnome-shell)
  2. 包管理器鉤子 (--hook)，通過 stdin 接收變動的 .mo 路徑並毫秒級增量轉換
  3. 過期增量同步 (--outdated)，僅處理源新於目標或缺失/孤兒的組件（供 dpkg 觸發器等）
  4. 可選導出 PO 文件 (--save-po) 以供審查
"""

from __future__ import annotations

import argparse
import concurrent.futures
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

DEFAULT_SRC_DIR = Path("/usr/share/locale/zh_CN/LC_MESSAGES")
DEFAULT_DEST_DIR = Path("/usr/share/locale/zh_CN@traditional/LC_MESSAGES")
DEFAULT_CONFIG = Path("/etc/zh-cn-traditional/overrides.tsv")

DEFAULT_DESKTOP_SRC = Path("/usr/share/applications")


def get_default_desktop_dest() -> Path:
    """
    獲取默認用戶級 desktop 目標目錄。
    若在 sudo 環境下運行，自動識別原登錄用戶的家目錄。
    """
    sudo_user = os.environ.get("SUDO_USER")
    if sudo_user:
        try:
            import pwd

            return (
                Path(pwd.getpwnam(sudo_user).pw_dir)
                / ".local"
                / "share"
                / "applications"
            )
        except (KeyError, ImportError):
            pass
    return Path.home() / ".local" / "share" / "applications"


DESKTOP_SIGNATURE = "# Generated by zh-cn-traditional-sync. Do not edit manually.\n"

# 本地開發備用路徑
REPO_ROOT = Path(__file__).resolve().parent.parent
LOCAL_CONFIG = REPO_ROOT / "config" / "overrides.tsv"


def find_config(custom_path: str | None = None) -> Path | None:
    if custom_path:
        p = Path(custom_path)
        return p if p.is_file() else None
    if DEFAULT_CONFIG.is_file():
        return DEFAULT_CONFIG
    if LOCAL_CONFIG.is_file():
        return LOCAL_CONFIG
    return None


def load_overrides(filepath: Path | None) -> list[tuple[str, str]]:
    overrides = []
    if not filepath or not filepath.is_file():
        return overrides
    with open(filepath, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split("\t")
            if len(parts) >= 2:
                overrides.append((parts[0], parts[1]))
    return overrides


def apply_overrides(text: str, overrides: list[tuple[str, str]]) -> str:
    for src, dst in overrides:
        text = text.replace(src, dst)
    return text


def convert_po_text(po_text: str, converter, overrides: list[tuple[str, str]]) -> str:
    """
    僅轉換 PO 中的翻譯內容 (msgstr)，嚴格保持 msgid 與文件頭不變。
    """
    lines = po_text.splitlines(keepends=True)
    out = []
    in_msgstr = False
    is_header = False
    has_seen_header = False

    for line in lines:
        if not has_seen_header and line.startswith('msgid ""'):
            is_header = True
            has_seen_header = True
            in_msgstr = False
            out.append(line)
        elif line.startswith("msgid"):
            is_header = False
            in_msgstr = False
            out.append(line)
        elif line.startswith("msgstr"):
            in_msgstr = True
            if is_header:
                out.append(line)
            else:
                parts = line.split('"', 1)
                if len(parts) == 2:
                    converted = converter.convert(parts[1])
                    if overrides:
                        converted = apply_overrides(converted, overrides)
                    out.append(parts[0] + '"' + converted)
                else:
                    out.append(line)
        elif in_msgstr:
            if line.startswith('"'):
                if is_header:
                    out.append(line)
                else:
                    converted = converter.convert(line[1:])
                    if overrides:
                        converted = apply_overrides(converted, overrides)
                    out.append('"' + converted)
            else:
                in_msgstr = False
                out.append(line)
        else:
            if is_header and line.startswith('"'):
                # 這是多行 msgid（非空 PO Header），取消 header 標記
                is_header = False
            in_msgstr = False
            out.append(line)

    return "".join(out)


_worker_converter = None
_worker_overrides = None


def _init_worker(overrides: list[tuple[str, str]]):
    global _worker_converter, _worker_overrides
    try:
        import opencc
    except ImportError:
        sys.exit(
            "錯誤: 需要安裝 opencc Python 模塊 (例如: pacman -S opencc, apt install python3-opencc, 或 dnf install python3-opencc)。"
        )
    _worker_converter = opencc.OpenCC("s2t")
    _worker_overrides = overrides


def _convert_domain_worker(
    domain: str, src_dir: Path, dest_dir: Path, save_po_dir: Path | None = None
) -> tuple[str, bool, str]:
    global _worker_converter, _worker_overrides
    src_mo = src_dir / f"{domain}.mo"
    if not src_mo.is_file():
        dest_mo = dest_dir / f"{domain}.mo"
        if dest_mo.is_file() or dest_mo.is_symlink():
            try:
                dest_mo.unlink()
                if domain == "coreutils":
                    lc_time_mo = dest_dir.parent / "LC_TIME" / "coreutils.mo"
                    if lc_time_mo.is_symlink() or lc_time_mo.is_file():
                        lc_time_mo.unlink()
                return domain, True, "已清理孤兒 MO"
            except OSError as e:
                return domain, False, f"清理孤兒 MO 失敗: {e}"
        return domain, False, f"未找到源 MO 文件: {src_mo}"

    try:
        po_bytes = subprocess.check_output(
            ["msgunfmt", str(src_mo)], stderr=subprocess.PIPE
        )
        po_raw = po_bytes.decode("utf-8", errors="replace")
    except subprocess.CalledProcessError as e:
        err = (
            e.stderr.decode("utf-8", errors="replace")
            if isinstance(e.stderr, bytes)
            else str(e.stderr)
        )
        return domain, False, f"msgunfmt 失敗: {err.strip()}"

    converted_po = convert_po_text(po_raw, _worker_converter, _worker_overrides)

    if save_po_dir:
        save_po_dir.mkdir(parents=True, exist_ok=True)
        po_out_path = save_po_dir / f"{domain}.po"
        with open(po_out_path, "w", encoding="utf-8") as f:
            f.write(converted_po)

    dest_dir.mkdir(parents=True, exist_ok=True)
    out_mo = dest_dir / f"{domain}.mo"

    # 直接管道寫入 msgfmt 生成 .mo
    proc = subprocess.run(
        ["msgfmt", "-c", "-", "-o", str(out_mo)],
        input=converted_po,
        text=True,
        capture_output=True,
    )
    if proc.returncode != 0:
        # 上游可能存在重複 msgid（如 git），嘗試調用 msguniq 去重
        proc_uniq = subprocess.run(
            ["msguniq", "--use-first"],
            input=converted_po,
            text=True,
            capture_output=True,
        )
        if proc_uniq.returncode == 0:
            proc = subprocess.run(
                ["msgfmt", "-c", "-", "-o", str(out_mo)],
                input=proc_uniq.stdout,
                text=True,
                capture_output=True,
            )
        if proc.returncode != 0:
            return domain, False, f"msgfmt 編譯失敗: {proc.stderr.strip()}"

    return domain, True, "OK"


def ensure_lc_time_symlink(dest_dir: Path):
    """
    確保 LC_TIME/coreutils.mo 軟鏈接指向 LC_MESSAGES/coreutils.mo
    """
    coreutils_mo = dest_dir / "coreutils.mo"
    if coreutils_mo.is_file():
        lc_time_dir = dest_dir.parent / "LC_TIME"
        lc_time_dir.mkdir(parents=True, exist_ok=True)
        link_path = lc_time_dir / "coreutils.mo"
        target = Path("../LC_MESSAGES/coreutils.mo")
        if not link_path.is_symlink():
            if link_path.exists():
                link_path.unlink()
            link_path.symlink_to(target)


def extract_domains_from_stdin() -> list[str]:
    """
    解析包管理器（如 pacman hook NeedsTargets）傳入的目標路徑行。
    例如輸入:
      usr/share/locale/zh_CN/LC_MESSAGES/git.mo
      /usr/share/locale/zh_CN/LC_MESSAGES/gnome-shell.mo
    解析出: ['git', 'gnome-shell']
    """
    if sys.stdin.isatty():
        return []
    domains = set()
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        # 兼容帶有或不帶有前導斜槓的路徑
        if "zh_CN/LC_MESSAGES" in line and line.endswith(".mo"):
            stem = Path(line).stem
            if stem:
                domains.add(stem)
        elif line.endswith(".mo"):
            domains.add(Path(line).stem)
        else:
            domains.add(line)
    return sorted(domains)


def collect_outdated_domains(src_dir: Path, dest_dir: Path) -> set[str]:
    """
    收集需要增量處理的組件：源 MO 缺失於目標、源新於目標，或目標孤兒（源已刪除）。
    """
    domains: set[str] = set()
    if src_dir.is_dir():
        for src_mo in src_dir.glob("*.mo"):
            dest_mo = dest_dir / src_mo.name
            try:
                if (
                    not dest_mo.is_file()
                    or src_mo.stat().st_mtime > dest_mo.stat().st_mtime
                ):
                    domains.add(src_mo.stem)
            except OSError:
                domains.add(src_mo.stem)
    if dest_dir.is_dir():
        for dest_mo in dest_dir.glob("*.mo"):
            if not (src_dir / dest_mo.name).is_file():
                domains.add(dest_mo.stem)
    return domains


def clean_desktop_copies(dest_dir: Path | None = None, quiet: bool = False) -> int:
    """
    安全清空由 zh-cn-traditional-sync 生成的用戶級 .desktop 副本。
    """
    target_dir = dest_dir or get_default_desktop_dest()
    if not target_dir.is_dir():
        if not quiet:
            print("用戶桌面目錄不存在，無待清理項。")
        return 0

    removed = 0
    for f in target_dir.glob("*.desktop"):
        try:
            with open(f, "r", encoding="utf-8", errors="replace") as fp:
                first_line = fp.readline()
                if first_line.startswith("# Generated by zh-cn-traditional-sync"):
                    f.unlink()
                    removed += 1
        except OSError:
            pass

    if shutil.which("update-desktop-database"):
        subprocess.run(["update-desktop-database", str(target_dir)], capture_output=True)

    if not quiet:
        print(f"zh-cn-traditional-sync: 已安全清理 {removed} 個由本工具生成的 .desktop 副本。")
    return removed


def sync_desktop_entries(
    src_dir: Path,
    dest_dir: Path | None = None,
    overrides: list[tuple[str, str]] | None = None,
    yes: bool = False,
    quiet: bool = False,
) -> None:
    """
    將系統 .desktop 文件中的中文條目繁體化覆蓋至用戶目錄，並自動清理孤兒項。
    """
    target_dest = dest_dir or get_default_desktop_dest()
    if yes and not quiet:
        print(f"zh-cn-traditional-sync: 桌面快捷方式目標目錄: {target_dest}")
    if not yes:
        if not sys.stdin.isatty():
            sys.exit("錯誤: --desktop 操作具有覆蓋性，非交互終端請傳入 -y / --yes 確認執行。")
        print("========================================================================")
        print("[操作確認] 即將為系統桌面快捷方式 (.desktop) 生成繁體化副本至用戶目錄：")
        print(f"  目標目錄: {target_dest}")
        print("  * 注入 Name / Comment / Keywords 等項的 zh_CN@traditional 繁體翻譯")
        print("  * 自動檢測並清理已卸載應用的孤兒快捷方式")
        print("  * 隨時可使用 zh-cn-traditional-sync --clean-desktop 一鍵清空撤銷")
        print("========================================================================")
        try:
            choice = input("是否繼續執行？[Y/n]: ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print("\n操作已取消。")
            return
        if choice in ("n", "no"):
            print("操作已取消。")
            return

    try:
        import opencc
    except ImportError:
        sys.exit("錯誤: 需要安裝 opencc Python 模塊。")

    converter = opencc.OpenCC("s2t")
    target_dest.mkdir(parents=True, exist_ok=True)
    sudo_user = os.environ.get("SUDO_USER")
    sudo_uid, sudo_gid = None, None
    if sudo_user:
        try:
            import pwd

            u = pwd.getpwnam(sudo_user)
            sudo_uid, sudo_gid = u.pw_uid, u.pw_gid
        except (KeyError, ImportError):
            pass

    # 1. 孤兒清理：若系統源文件已不存在，說明該軟件已被卸載，刪除用戶級殘留
    orphans = 0
    for df in target_dest.glob("*.desktop"):
        try:
            with open(df, "r", encoding="utf-8", errors="replace") as fp:
                first_line = fp.readline()
                if first_line.startswith("# Generated by zh-cn-traditional-sync"):
                    src_f = src_dir / df.name
                    if not src_f.is_file():
                        df.unlink()
                        orphans += 1
        except OSError:
            pass

    # 2. 遍歷系統源目錄生成/更新繁體化副本
    synced = 0
    key_pattern = re.compile(r"^([A-Za-z0-9_-]+)\[zh_CN\](\s*=\s*)(.*)$")

    for src_f in sorted(src_dir.glob("*.desktop")):
        try:
            with open(src_f, "r", encoding="utf-8", errors="replace") as fp:
                content = fp.read()
        except OSError:
            continue

        if "[zh_CN]" not in content:
            continue

        lines = content.splitlines(keepends=True)
        new_lines = [DESKTOP_SIGNATURE]
        for line in lines:
            # 略過原文件中可能殘留的舊簽名行
            if line.startswith("# Generated by zh-cn-traditional-sync"):
                continue
            # 若源文件已有 zh_CN@traditional，略過它，由我們統一生成
            if "[zh_CN@traditional]" in line:
                continue

            new_lines.append(line)
            m = key_pattern.match(line.rstrip("\r\n"))
            if m:
                key, eq, val = m.groups()
                trad_val = converter.convert(val)
                if overrides:
                    trad_val = apply_overrides(trad_val, overrides)
                new_lines.append(f"{key}[zh_CN@traditional]{eq}{trad_val}\n")

        dest_f = target_dest / src_f.name
        try:
            with open(dest_f, "w", encoding="utf-8") as fp:
                fp.writelines(new_lines)
            if sudo_uid is not None and sudo_gid is not None:
                try:
                    os.chown(dest_f, sudo_uid, sudo_gid)
                except OSError:
                    pass
            synced += 1
        except OSError as e:
            if not quiet:
                print(f"[WARN] 寫入 {dest_f} 失敗: {e}", file=sys.stderr)

    if shutil.which("update-desktop-database"):
        subprocess.run(["update-desktop-database", str(target_dest)], capture_output=True)

    if not quiet:
        msg = f"zh-cn-traditional-sync: 桌面快捷方式同步完成 (新增/更新: {synced} 個"
        if orphans > 0:
            msg += f"，清理孤兒項: {orphans} 個"
        msg += ")。"
        print(msg)


def main():
    parser = argparse.ArgumentParser(
        description="zh-cn-traditional-sync: 動態將系統 zh_CN 翻譯轉換爲繁體 zh_CN@traditional"
    )
    parser.add_argument("domains", nargs="*", help="指定組件名稱（如 git, baobab）")
    parser.add_argument("-a", "--all", action="store_true", help="全量同步系統所有 zh_CN 組件的 MO（不含桌面快捷方式；如需同時同步桌面，另加 --desktop）")
    parser.add_argument(
        "--outdated",
        action="store_true",
        help="僅同步過期/缺失組件並清理孤兒 MO（源新於目標或目標不存在；供 dpkg 觸發器等無文件列表的增量場景）",
    )
    parser.add_argument(
        "--desktop",
        action="store_true",
        help="生成或更新用戶級 .desktop 繁體化副本 (~/.local/share/applications/)，自動清理已卸載應用的孤兒快捷方式；與 --all 合用時，在 MO 同步完成後執行",
    )
    parser.add_argument(
        "--clean-desktop",
        action="store_true",
        help="安全清空所有由本工具生成的用戶級 .desktop 繁體化副本",
    )
    parser.add_argument(
        "-y",
        "--yes",
        action="store_true",
        help="免交互執行（自動確認）",
    )
    parser.add_argument(
        "--desktop-src-dir",
        type=Path,
        default=DEFAULT_DESKTOP_SRC,
        help=f"系統 .desktop 來源目錄 (默認: {DEFAULT_DESKTOP_SRC})",
    )
    parser.add_argument(
        "--desktop-dest-dir",
        type=Path,
        default=None,
        help="用戶級 .desktop 目標目錄 (默認: 自動檢測用戶 ~/.local/share/applications)",
    )
    parser.add_argument(
        "--no-desktop",
        action="store_true",
        help="不執行桌面同步（與 --desktop 合用時優先於 --desktop；--all 默認已不含桌面）",
    )
    parser.add_argument(
        "--hook",
        action="store_true",
        help="包管理器鉤子模式（從 stdin 讀取變動的文件列表）",
    )
    parser.add_argument(
        "--src-dir",
        type=Path,
        default=DEFAULT_SRC_DIR,
        help=f"源 zh_CN 目錄 (默認: {DEFAULT_SRC_DIR})",
    )
    parser.add_argument(
        "--dest-dir",
        type=Path,
        default=DEFAULT_DEST_DIR,
        help=f"目標 zh_CN@traditional 目錄 (默認: {DEFAULT_DEST_DIR})",
    )
    parser.add_argument(
        "--config",
        type=str,
        default=None,
        help="自定義詞彙微調配置文件 (overrides.tsv)",
    )
    parser.add_argument(
        "--save-po",
        type=Path,
        default=None,
        help="可選：將轉換後的 PO 文件保存至指定目錄（調試/審查用）",
    )
    parser.add_argument("-q", "--quiet", action="store_true", help="靜默模式，僅輸出錯誤")
    parser.add_argument(
        "-j",
        "--workers",
        type=int,
        default=min(os.cpu_count() or 4, 8),
        help="並發工作進程數 (默認: 自動檢測)",
    )
    args = parser.parse_args()

    config_path = find_config(args.config)
    overrides = load_overrides(config_path)

    target_desktop_dest = args.desktop_dest_dir or get_default_desktop_dest()

    if args.clean_desktop:
        clean_desktop_copies(target_desktop_dest, quiet=args.quiet)
        return

    mo_requested = bool(args.domains) or args.all or args.outdated or args.hook
    if args.desktop and not args.no_desktop and not mo_requested:
        sync_desktop_entries(
            args.desktop_src_dir,
            target_desktop_dest,
            overrides,
            yes=args.yes,
            quiet=args.quiet,
        )
        return

    domains_to_process = set(args.domains)

    if args.hook:
        domains_to_process.update(extract_domains_from_stdin())

    if args.all:
        if args.src_dir.is_dir():
            for f in args.src_dir.glob("*.mo"):
                domains_to_process.add(f.stem)
    elif args.outdated:
        domains_to_process.update(
            collect_outdated_domains(args.src_dir, args.dest_dir)
        )

    if not domains_to_process:
        # --all/--outdated --desktop 且無 MO 時，仍應執行桌面同步（舊行為會在此提前返回）。
        if (args.all or args.outdated) and args.desktop and not args.no_desktop:
            sync_desktop_entries(
                args.desktop_src_dir,
                target_desktop_dest,
                overrides,
                yes=args.yes,
                quiet=args.quiet,
            )
            return
        if not args.quiet:
            print("無待處理組件。使用 --all 執行 MO 全量同步，或使用 --desktop 繁體化桌面快捷方式。")
        return

    domain_list = sorted(domains_to_process)
    total = len(domain_list)
    is_interactive = sys.stdout.isatty() and not args.quiet

    if not args.quiet:
        print(f"zh-cn-traditional-sync: 正在同步 {total} 個組件...")

    success = 0
    done = 0
    with concurrent.futures.ProcessPoolExecutor(
        max_workers=args.workers, initializer=_init_worker, initargs=(overrides,)
    ) as executor:
        futures = {
            executor.submit(
                _convert_domain_worker, d, args.src_dir, args.dest_dir, args.save_po
            ): d
            for d in domain_list
        }
        for future in concurrent.futures.as_completed(futures):
            domain, ok, msg = future.result()
            done += 1
            if ok:
                success += 1
            else:
                if is_interactive:
                    sys.stdout.write("\r\033[K")
                    sys.stdout.flush()
                print(f"[FAIL] {domain}: {msg}", file=sys.stderr)

            if is_interactive:
                percent = (done / total) * 100
                bar_len = 20
                filled = int(bar_len * done // total)
                bar = "█" * filled + "░" * (bar_len - filled)
                short_name = domain if len(domain) <= 18 else domain[:15] + "..."
                sys.stdout.write(
                    f"\r[{bar}] {done}/{total} ({percent:5.1f}%) {short_name:<18}"
                )
                sys.stdout.flush()

    if is_interactive:
        sys.stdout.write("\r\033[K")
        sys.stdout.flush()

    ensure_lc_time_symlink(args.dest_dir)

    if not args.quiet:
        print(f"zh-cn-traditional-sync: 完成 ({success}/{total} 成功)。")

    if args.desktop and not args.no_desktop:
        if not args.quiet:
            print("\n正在同步桌面快捷方式 (.desktop)...")
        sync_desktop_entries(
            args.desktop_src_dir,
            target_desktop_dest,
            overrides,
            yes=args.yes,
            quiet=args.quiet,
        )

    if success < len(domain_list):
        sys.exit(1)


if __name__ == "__main__":
    main()
